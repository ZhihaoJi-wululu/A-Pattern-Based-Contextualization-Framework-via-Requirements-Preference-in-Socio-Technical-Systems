  "sources": {
    "persona": {
      "kind": "constructed_persona",
      "label": "Archive Persona: declared qualitative persona",
      "spans": {
        "Archive Persona": "Archive Persona is the Archive Coordinator for this constructed community heritage project. She enjoys reciprocal discussion and actively expresses her own position when arrangements are negotiable. She values orderly materials, generally expects good intentions within independently checked boundaries, and attends to a colleague's specific difficulties. These usual characteristics are separate from the episode conditions."
      }
    },
    "episode": {
      "kind": "constructed_context",
      "label": "Independently declared archive episode",
      "spans": {
        "quality_criteria": "The project separately declares these quality aspirations: Ease of Record Retrieval, Evidence Auditability, Reciprocal Communication, Empathetic Assistance, Review Reliability and Archive Traceability. For this constructed episode, indexing source records is sufficient for the agreed retrieval quality; keeping received order fails that additional quality while still retaining every required record. Indexing completion evidence is sufficient for the agreed auditability quality; appending it by date fails that additional quality while still retaining all required evidence. Both live discussion tasks contribute to reciprocal communication; either written-only route lacks the project's additional reciprocity criterion while remaining an approved sufficient channel. The step-by-step help supplies the extra, personally responsive relief defining empathetic assistance; the standard help sheet supplies necessary service without that extra quality. The independent integrity review supplies the declared review reliability criterion. Both indexing tasks contribute positively to Archive Traceability; keeping received source-record order or appending completion evidence only by date fails the additional traceability criterion. These are project-specific evaluation criteria, distinct from whether mandatory functional goals are achieved.",
        "archive_ownership": "The Archive Coordinator owns the overall Community Archive Delivered goal and coordinates its completion. The Independent Archivist retains responsibility for the integrity review, and the Heritage Council retains authority over public release.",
        "intake_reciprocal_opportunity": "For intake, Archive Persona has been invited to a live discussion where she can ask questions and respond; reading the intake guide has no reciprocal interaction.",
        "intake_approved_equivalent_channels": "The intake call and intake guide are both approved and equally sufficient for agreeing the same intake requirements.",
        "intake_no_uninterruptible_high_duty": "No uninterruptible high-duty work prevents either party from taking part in the intake discussion.",
        "intake_resources_available": "Both parties have enough time, current energy and work resources for the intake discussion.",
        "C_intake": "For Intake Agreed, the independently registered outcome criterion Reciprocal Intake is met by Discuss Intake Live and is not met by Read Intake Guide.",
        "schedule_negotiable_request": "The archive partner has requested a scan window and explicitly confirmed that this arrangement is genuinely negotiable.",
        "schedule_own_nonmandatory_preference": "Before this request, Archive Persona explicitly stated a nonmandatory preference for a different scan window; it differs from the partner's initial arrangement.",
        "schedule_both_responses_authorized": "Archive Persona is authorized either to express her alternative scan window or accept the initial offer; both are feasible within the same resources, mandatory work and hard deadlines.",
        "schedule_self_expression_difference": "Propose Own Window records Archive Persona's own position in the negotiation; Accept Offered Window completes the arrangement without expressing that position.",
        "C_schedule": "For Scan Window Agreed, the independently registered outcome criterion Own Position Expressed is met by Propose Own Window and is not met by Accept Offered Window.",
        "catalogue_visible_disorder": "The source records are visibly scattered and Archive Persona currently perceives this disorder.",
        "catalogue_actor_directory_standard": "Archive Persona accepts the current collection-and-date indexing standard for the source records.",
        "catalogue_minimum_retention_satisfied": "Both source-record filing methods retain every required record and satisfy minimum retention requirements.",
        "catalogue_organization_difference_known": "The independently registered source-record criterion establishes that indexing the source records meets the accepted standard and keeping their received order does not.",
        "C_catalogue": "For Source Records Filed, the independently registered outcome criterion Indexed Source Records is met by Index Source Records and is not met by Keep Received Order.",
        "digest_unfamiliar_partner": "The independent archivist offering the public-digest check is unfamiliar to Archive Persona.",
        "digest_identity_and_permission_verified": "The independent archivist's identity, permission and communication channel have already been independently verified for the digest check.",
        "digest_bounded_reversible_nonsensitive_cooperation": "The digest cooperation uses only a public checksum, grants no access, involves no sensitive information, has a small reversible scope and can be withdrawn.",
        "digest_negative_cues_checked_and_absent": "Negative cues for this digest cooperation have been checked and no unexplained counterevidence remains.",
        "digest_independent_alternative_valid": "Checking the same digest independently using the approved guide is a valid and equally sufficient way to complete the digest requirement.",
        "digest_cooperation_optional": "Archive Persona may decline the offered digest cooperation; selecting cooperation is optional even though completing the digest check is required.",
        "C_digest": "For Public Digest Checked, the independently registered outcome criterion Bounded Cooperation is met by Check Digest Together and is not met by Check Digest Alone.",
        "handover_reciprocal_opportunity": "For handover, Archive Persona has an actual invitation to reciprocal live Q&A where both parties ask questions and respond; the written handover guide provides no reciprocal participation.",
        "handover_approved_equivalent_channels": "The handover Q&A and written handover guide are approved and equally sufficient for understanding the same completed archive.",
        "handover_no_uninterruptible_high_duty": "No uninterruptible high-duty task prevents either party from taking part in the handover Q&A.",
        "handover_resources_available": "Both parties have enough time, current energy and work resources for the handover Q&A.",
        "C_handover": "For Handover Understood, the independently registered outcome criterion Reciprocal Handover is met by Discuss Handover Live and is not met by Read Handover Guide.",
        "evidence_visible_disorder": "The newly produced completion evidence is visibly disordered, independently of the source records, and Archive Persona currently perceives this disorder.",
        "evidence_actor_directory_standard": "For completion evidence, Archive Persona accepts the specified batch-and-outcome directory standard.",
        "evidence_minimum_retention_satisfied": "Indexing completion evidence and appending it by date both retain all required evidence and meet minimum retention requirements.",
        "evidence_organization_difference_known": "The independently registered completion-evidence criterion establishes that indexing meets the accepted directory standard and appending by date does not.",
        "C_evidence": "For Completion Evidence Filed, the independently registered outcome criterion Indexed Completion Evidence is met by Index Completion Evidence and is not met by Append Evidence by Date.",
        "assistance_specific_difficulty_known": "Archive Persona perceives her colleague's independently verified, specific difficulty finding the correct archive batch and interpreting its index.",
        "assistance_relief_effect_known": "The independently registered assistance criterion establishes that step-by-step help gives additional relief of that specific difficulty; the sufficient standard help sheet does not give the same extra relief.",
        "assistance_minimum_service_guaranteed": "Both assistance routes guarantee all necessary service and access to the complete, usable archive.",
        "assistance_voluntary_extra_relief": "The extra step-by-step help is voluntary, both parties consent, Archive Persona has discretion to omit it, and omitting that extra help is legally permitted.",
        "assistance_voluntary_cost_affordable": "The cost of the voluntary extra help is affordable within Archive Persona's current disposable time, energy and work resources.",
        "C_assistance": "For Colleague Supported, the independently registered outcome criterion Specific Difficulty Relieved is met by Give Step-by-step Help and is not met by Send Standard Help Sheet."
      }
    }
  },
